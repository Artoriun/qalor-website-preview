{
  "name": "qalor-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "preview": "npm run preview --workspace=packages/web",
    "test:api": "node --import tsx --test \"packages/api/src/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"packages/web/src/**/*.test.ts\" \"packages/shared/src/**/*.test.ts\"",
    "test": "npm run test:api && npm run test:unit",
    "test:e2e": "playwright test",
    "test:e2e:dist": "E2E_TARGET=dist playwright test",
    "test:e2e:subpath": "E2E_TARGET=subpath playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prerender": "node scripts/prerender.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:lighthouse": "node scripts/check-lighthouse.mjs",
    "hash-password": "node scripts/hash-password.mjs",
    "ci": "node scripts/ci-local.mjs",
    "render:env": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/render-env.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "^1.62.0",
    "lighthouse": "^13.4.1",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2"
  },
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22.18"
  }
}
